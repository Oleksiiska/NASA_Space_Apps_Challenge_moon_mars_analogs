{$SITE_ADDRESS::80} {
	root * /srv/site
	encode zstd gzip

	@other not path / /index.html
	respond @other 404

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Cache-Control "no-cache"
	}

	file_server
	log {
		output stdout
		format console
	}
}
