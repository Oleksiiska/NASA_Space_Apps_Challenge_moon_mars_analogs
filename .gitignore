# Raw downloads and intermediate files are not committed: they are rebuilt by
# `python -m analog_finder fetch ...` (see README.md). Only the small Natural Earth
# land mask stays in the repository so that the grid can be rebuilt offline.
data/raw/**
!data/raw/**/
!data/raw/**/.gitkeep
!data/raw/earth/naturalearth/ne_50m_land.geojson
!data/raw/earth/naturalearth/ne_50m_glaciated_areas.geojson
data/interim/**
!data/interim/.gitkeep
*.part
.dodsrc

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Earthdata Login: never commit credentials
.netrc
_netrc
.env

# Web app
node_modules/
dist/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Experimental grids of other cell sizes (ANALOG_CELL_DEG), rebuilt from the raw data
data/processed_*/

# Outputs of `evaluate` (the baseline eval_baseline.json is kept)
data/processed/eval_current.json
data/processed/eval_holdout*.json
